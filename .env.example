PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://yourdomain.com
VITE_API_URL=/api
NODE_ENV=development
# ===== PROD (Vercel) — обязательно для отслеживания =====
# Без REDIS данные пропадают на каждом рестарте лямбды (файл эфемерный)
# Создай Upstash Redis (https://upstash.com) или Vercel KV и вставь URL
REDIS_URL=rediss://default:XXXX@xxx.upstash.io:6379
# альтернативные имена — любой из них подхватится: STORAGE_URL / STORAGE_REDIS_URL
# STORAGE_URL=rediss://...
FRONTEND_URL=https://yourdomain.vercel.app
DISCORD_REDIRECT_URI=https://yourdomain.vercel.app/api/auth/discord/callback
# Discord bot — для уведомлений из Copied Folder (скопировал группу → бот пришлёт DM с картинкой новой вещи)
# ВАЖНО: реальные токены уже утекли в git историю — СРОЧНО пересоздай в https://discord.com/developers/applications
DISCORD_BOT_TOKEN=PUT_YOUR_BOT_TOKEN_HERE_MTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMg.xxxxx
DISCORD_CLIENT_ID=PUT_YOUR_CLIENT_ID_HERE
DISCORD_CLIENT_SECRET=PUT_YOUR_CLIENT_SECRET_HERE
DISCORD_REDIRECT_URI=http://localhost:3001/api/auth/discord/callback
DISCORD_GUILD_ID=
FRONTEND_URL=http://localhost:5173
EGRESS_COUNT=3
# EGRESS_PROXIES=http://proxy1:8080,http://proxy2:8080
VPN_FAST=0
CHECK_INTERVAL_MS=420000

# Уникальный секрет для подписи токенов и защиты сессий (OAuth) — 32+ случайных байт
# Сгенерируй: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Если не задан — генерируется ephemeral и инвалидирует все старые wornby_auth куки после рестарта
SESSION_SECRET=change_me__generate_random_64_hex_chars
