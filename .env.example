# Copy to .env for local development. Never commit real values.
# The Rust API (cargo run --release --bin main) listens on PORT; the Vite dev proxy expects 3001.
PORT=3001
# Comma-separated origins allowed to call the API cross-origin. In production cross-origin calls are denied when unset.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://yourdomain.com
VITE_API_URL=/api
NODE_ENV=development

# Roblox request tuning (optional): independent connection pools, each optionally behind a proxy
EGRESS_COUNT=3
# EGRESS_PROXIES=http://proxy1:8080,http://proxy2:8080
