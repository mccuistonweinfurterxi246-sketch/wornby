    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "framer-motion": "^13.1.1",
    "lru-cache": "^11.0.2",
    "lucide-react": "^0.475.0",
    "ogl": "^1.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
